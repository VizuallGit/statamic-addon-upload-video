{
    "name": "statamic-addon/upload-video",
    "description": "Fit videos in the asset library and save the first frame as a poster",
    "type": "statamic-addon",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Vizuall\\UploadVideo\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Vizuall Upload Video",
            "description": "Fit videos in the asset library and save the first frame as a poster",
            "provider": "Vizuall\\UploadVideo\\AddonServiceProvider"
        },
        "laravel": {
            "providers": [
                "Vizuall\\UploadVideo\\AddonServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
